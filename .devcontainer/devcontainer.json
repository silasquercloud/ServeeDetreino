{
  "name": "Ryuex Treino — desenvolvimento e testes",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "additionalVersions": "8",
      "installMaven": false,
      "installGradle": false,
      "jdkDistro": "tem"
    }
  },
  "postCreateCommand": "python3 scripts/build.py",
  "portsAttributes": {
    "25565": {
      "label": "Minecraft TCP — não é URL HTTP",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java"
      ]
    }
  }
}
